<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Learning Resource Service</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <header class="site-header">
        <div class="container nav-container">
            <a class="brand"
               asp-controller="Home"
               asp-action="Index">
                <span class="brand-icon">LR</span>
                <span>Learning Resource Portal</span>
            </a>

            <nav class="main-nav" aria-label="Main navigation">
                <a asp-controller="Home"
                   asp-action="Index">Home</a>

                <a asp-controller="Resources"
                   asp-action="Index">Browse Resources</a>

                <a asp-controller="Categories"
                   asp-action="Index">Categories</a>

                <a asp-controller="Resources"
                   asp-action="Create"
                   class="nav-highlight">+ Add Resource</a>
            </nav>

            <div class="account-nav">
                <a asp-controller="Account"
                   asp-action="Login"
                   class="login-link">Login</a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="button button-small">Register</a>
            </div>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <div>
                <strong>Learning Resource Portal</strong>
                <p>Find, share, and explore learning resources.</p>
            </div>

            <div class="footer-links">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Resources" asp-action="Index">Resources</a>
                <a asp-controller="Account" asp-action="Login">Login</a>
            </div>

            <p class="copyright">
                &copy; @DateTime.Now.Year Learning Resource Portal
            </p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>