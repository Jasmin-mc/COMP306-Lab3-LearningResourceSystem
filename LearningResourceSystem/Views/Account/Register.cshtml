@{
    ViewData["Title"] = "Register";
}
<!--Important: The current Register controller doesn't yet check that the two passwords match. ADD LATE-->

<section class="auth-container">
    <div class="auth-panel">
        <div class="auth-logo">LR</div>

        <h1>Create your account</h1>
        <p class="auth-subtitle">
            Join the community and share learning resources.
        </p>

        <form asp-controller="Account"
              asp-action="Register"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="validation-summary"></div>

            <div class="form-group">
                <label for="username">Username</label>
                <input id="username"
                       name="username"
                       class="form-control"
                       autocomplete="username"
                       required
                       placeholder="Choose a username" />
            </div>

            <div class="form-group">
                <label for="email">Email address</label>
                <input id="email"
                       name="email"
                       type="email"
                       class="form-control"
                       autocomplete="email"
                       required
                       placeholder="you@example.com" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input id="password"
                       name="password"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       required
                       minlength="8"
                       placeholder="At least 8 characters" />
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm password</label>
                <input id="confirmPassword"
                       name="confirmPassword"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       required
                       minlength="8"
                       placeholder="Enter your password again" />
            </div>

            <button type="submit" class="button button-full">
                Create Account
            </button>
        </form>

        <p class="auth-switch">
            Already have an account?
            <a asp-controller="Account" asp-action="Login">
                Login here
            </a>
        </p>

        <p class="field-help">
            Demo placeholder only. Registration is not connected yet.
        </p>
    </div>
</section>